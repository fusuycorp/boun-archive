# Database
POSTGRES_USER=boun_user
POSTGRES_PASSWORD=boun_password
POSTGRES_DB=boun_archive
DB_HOST=db
DB_PORT=5432

# Meilisearch
MEILI_MASTER_KEY=masterKeyLongEnough123
MEILI_ENV=production
MEILI_HOST=meilisearch
MEILI_PORT=7700

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
PORT=8000
# These are used by the app. For local development outside docker, change 'db', 'meilisearch', 'redis' to 'localhost'
DATABASE_URL=postgresql://boun_user:boun_password@db:5432/boun_archive
MEILI_URL=http://meilisearch:7700
REDIS_URL=redis://redis:6379

# Frontend
FRONTEND_PORT=3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:80
