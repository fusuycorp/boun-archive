# Database Configuration
POSTGRES_USER=boun_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=boun_archive
DB_HOST=db
DB_PORT=5432

# Meilisearch Search Engine
MEILI_MASTER_KEY=change-me-minimum-16-chars
MEILI_ENV=production
MEILI_HOST=meilisearch
MEILI_PORT=7700

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379

# Backend API
PORT=8000
# Connection strings (used by backend service)
# Note: For local development outside docker, change 'db', 'meilisearch', 'redis' to 'localhost'
DATABASE_URL=postgresql://boun_user:change-me@db:5432/boun_archive
MEILI_URL=http://meilisearch:7700
REDIS_URL=redis://redis:6379
CORS_ORIGINS=*

# Frontend
FRONTEND_PORT=3000
PUBLIC_API_URL=/api
